{
  "name": "simplelogin-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SimpleLogin rebuilt as a Cloudflare-native serverless application (Workers + D1 + KV + Email Routing)",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwahdany/simplelogin-cf.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:templates": "node scripts/build-templates.mjs",
    "build:assets": "node scripts/build-assets.mjs && node scripts/check-assets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "pretest": "node scripts/build-templates.mjs",
    "predeploy": "node scripts/build-templates.mjs && node scripts/build-assets.mjs && node scripts/check-assets.mjs",
    "pretypecheck": "node scripts/build-templates.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "hono": "^4.12.27",
    "openpgp": "^6.3.1",
    "otpauth": "^9.5.1",
    "postal-mime": "^2.7.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@sentry/browser": "^5.30.0",
    "@types/nunjucks": "^3.2.6",
    "bootbox": "^5.5.3",
    "font-awesome": "^4.7.0",
    "htmx.org": "^1.9.12",
    "intro.js": "^2.9.3",
    "multiple-select": "^1.7.0",
    "nunjucks": "^3.2.4",
    "parsleyjs": "^2.9.2",
    "qrious": "^4.0.2",
    "toastr": "^2.1.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue": "^2.7.16",
    "wrangler": "^4.107.0"
  }
}
